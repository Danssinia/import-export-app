// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url= env("DATABASE_URL")
}
enum UserRole {
  USER
  ADMIN
}

enum TradeType {
  IMPORT
  EXPORT
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
}

enum OrderStatus {
  WAITING
  ACCEPTED
  REJECTED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  user_id   String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  address   String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //references for the relation-ships
  products Product[]
  orders   Order[]
  requests Request[]
}

model Product {
  product_id  String        @id @default(uuid())
  seller_id   String
  title       String
  description String
  price       String
  category    String
  type        TradeType     @default(IMPORT)
  totalCount  Int
  soldCount   Int
  images      String[]
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  //references for relation-ship
  order Order[]

  //relation-ships
  seller User @relation(fields: [seller_id], references: [user_id])
}

model Order {
  order_id  String      @id @default(uuid())
  status    OrderStatus @default(WAITING)
  userId    String
  productID String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  //relation-ships
  user    User    @relation(fields: [userId], references: [user_id])
  product Product @relation(fields: [productID], references: [product_id])
}

model Request {
  request_id      String        @id @default(uuid())
  userId          String
  itemName        String
  itemDescription String
  status          RequestStatus @default(PENDING)
  images          String[]
  price           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  //relation-ships
  user User @relation(fields: [userId], references: [user_id])
}